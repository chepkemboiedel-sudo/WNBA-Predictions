# Example configuration for server.py  (Feature 1.2: no secrets in the repo)
#
# Copy to ".env" and adjust as needed. ".env" is git-ignored and is NEVER
# committed. This app needs NO API keys or credentials of any kind -- ESPN's
# public feeds are keyless -- so every value below is an operational setting,
# not a secret. On a host like Render / Railway / Cloud Run, set these in the
# platform's environment-variable UI instead of a file.

# Port the server listens on. Most hosts inject $PORT automatically.
PORT=8000
HOST=0.0.0.0

# Rate limit (Feature 2.1): max requests per client per sliding window.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SEC=60

# Where structured request logs are appended (Feature 1.3). One JSON per line.
LOG_PATH=logs/requests.jsonl

# Illustrative price used to estimate per-request cost in the usage summary
# (Feature 2.3). This is a non-LLM app, so "tokens" are a payload-size proxy;
# see LAB.md. Set to 0 to report true infrastructure cost (free tier = $0).
PRICE_PER_1K_TOKENS_USD=0.002

# Set to 1 to force every API call to fail, for the graceful-degradation demo
# (Feature 2.2). Leave at 0 in normal operation.
FORCE_FAIL=0

# --- LLM endpoint (/api/explain) -- gives REAL token counts and cost ---------
# The API key is the ONLY real secret in this app. Keep it out of the repo: set
# it in your host's env UI (Render dashboard) or a git-ignored .env, never here.
# The endpoint works with EITHER Google Gemini OR Anthropic Claude -- set the key
# for whichever you have. When no key is set, /api/explain degrades gracefully
# and the rest of the app is unaffected.
#
# Provider is auto-detected from whichever key is present (Gemini preferred).
# Force one explicitly if you set both:  LLM_PROVIDER=gemini  (or anthropic)
LLM_PROVIDER=auto

# --- Option A: Google Gemini (free tier -- recommended for this lab) ----------
GEMINI_API_KEY=REPLACE-ME
# Pick a model your key can access (see aistudio.google.com). "gemini-2.5-flash"
# is the default; Google may offer newer gemini-3.x flash models -- use whatever
# your AI Studio console lists as current.
GEMINI_MODEL=gemini-2.5-flash

# --- Option B: Anthropic Claude (alternative) --------------------------------
# ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
# LLM_MODEL=claude-opus-5-5          # or claude-haiku-5-5 for cheaper/faster

# Per-1K-token prices for cost estimates. Defaults ~ Gemini 2.5 Flash.
# Claude Opus 5.5: 0.004 / 0.020   |   Claude Haiku 5.5: 0.0001 / 0.0005
LLM_PRICE_INPUT_PER_1K=0.0003
LLM_PRICE_OUTPUT_PER_1K=0.0025
LLM_MAX_TOKENS=2048
