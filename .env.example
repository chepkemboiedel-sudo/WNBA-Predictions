# Example configuration for server.py  (Feature 1.2: no secrets in the repo)
#
# Copy to ".env" and adjust as needed. ".env" is git-ignored and is NEVER
# committed. This app needs NO API keys or credentials of any kind -- ESPN's
# public feeds are keyless -- so every value below is an operational setting,
# not a secret. On a host like Render / Railway / Cloud Run, set these in the
# platform's environment-variable UI instead of a file.

# Port the server listens on. Most hosts inject $PORT automatically.
PORT=8000
HOST=0.0.0.0

# Rate limit (Feature 2.1): max requests per client per sliding window.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SEC=60

# Where structured request logs are appended (Feature 1.3). One JSON per line.
LOG_PATH=logs/requests.jsonl

# Illustrative price used to estimate per-request cost in the usage summary
# (Feature 2.3). This is a non-LLM app, so "tokens" are a payload-size proxy;
# see LAB.md. Set to 0 to report true infrastructure cost (free tier = $0).
PRICE_PER_1K_TOKENS_USD=0.002

# Set to 1 to force every API call to fail, for the graceful-degradation demo
# (Feature 2.2). Leave at 0 in normal operation.
FORCE_FAIL=0

# --- LLM endpoint (/api/explain) -- gives REAL token counts and cost ---------
# The ONLY real secret in this app. Keep it out of the repo: set it in your
# host's env UI (Render dashboard) or a git-ignored .env, never here.
# When unset, /api/explain degrades gracefully ("LLM not configured") and the
# rest of the app is unaffected.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Model for the explanation endpoint. Default is Claude Opus 5.5.
# For a cheaper/faster demo, set: LLM_MODEL=claude-haiku-5-5  (and the prices below)
LLM_MODEL=claude-opus-5-5
# Per-1K-token prices for LLM_MODEL (defaults = Claude Opus 5.5: $4 / $20 per 1M).
# Claude Haiku 5.5 is 0.0001 / 0.0005.
LLM_PRICE_INPUT_PER_1K=0.004
LLM_PRICE_OUTPUT_PER_1K=0.020
LLM_MAX_TOKENS=2048
